    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@types/lodash": "^4.17.25",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "angular-eslint": "^22.5.0",
    "autoprefixer": "^10.5.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
