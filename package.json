    "@vercel/analytics": "^2.0.1",
    "angular-svg-icon": "^19.1.1",
    "angularx-qrcode": "^22.0.1",
    "filesize": "^11.0.23",
    "flowbite": "^4.0.2",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "ng-otp-input": "^2.0.10",
    "ngx-mask": "^22.2.1",
    "ngx-moment": "^6.0.2",
