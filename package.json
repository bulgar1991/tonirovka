{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/optimize-images.mjs && node scripts/run-ts.mjs scripts/manifests.ts src",
    "start": "ng serve",
    "prebuild": "node scripts/optimize-images.mjs && node scripts/run-ts.mjs scripts/manifests.ts src",
    "build": "ng build && node scripts/run-ts.mjs scripts/seo-pages.ts dist/frontend/browser",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint --fix",
    "prettier": "npx prettier --write .",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "images": "node scripts/optimize-images.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
